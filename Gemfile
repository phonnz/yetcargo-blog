source "https://rubygems.org"

ruby ">= 3.4"

# Site generator. Jekyll 4.4 officially supports Ruby 3.4.
gem "jekyll", "~> 4.4"

# Plugins declared in _config.yml (`plugins:`). The custom generators in
# _plugins/ also depend on Jekyll::Paginate::Pager from jekyll-paginate.
gem "jekyll-paginate", "~> 1.1"
gem "jekyll-feed", "~> 0.17"

# `jekyll serve` needs webrick, which is no longer bundled with Ruby.
gem "webrick", "~> 1.8"

gem "rake", "~> 13.0"
